def option1(n):
    if n > 0:
        print("positive.")
    elif n < 0:
        print("negative.")
    else:
        print("zero.")

def option2(n):
    if n % 2 == 0:
        print("even")
    else:
        print("odd")

def option3(n):
    count = 0
    while n > 0:
        n //= 10
        count += 1
    print(count)

def main():
    n = int(input("Enter a number: "))
    option1(n)
    option2(n)
    option3(n)

main()
